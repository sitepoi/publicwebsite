# Relay tooling parity (GET /api/relay/ras)
RELAY_SECRET=demo-relay-secret

# Form rate limits (Section 14)
FORMS_RATE_LIMIT_MAX=20
FORMS_RATE_LIMIT_WINDOW_MS=60000

# reCAPTCHA v3 (optional — enabled per folder webSettings, Section 14)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# AWS SES email (optional — used by operation/form hooks, Section 15)
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=eu-west-1

# Publish webhook purge (Section 18)
REVALIDATE_SECRET=demo-revalidate-secret

# IndexNow ping on publish (Section 16, optional)
INDEXNOW_API_KEY=

# Error tracking (Section 20, optional)
SENTRY_DSN=

# Dev-only fixture site (C4): '1' serves the in-memory fixture pages instead
# of Firestore — for local development / e2e. Never set in production.
GW_DEV_FIXTURES=0

# Per-tenant env convention (Section 22) — examples:
#   WEBSITE_BUILDER_firebase_admin_project_id=...
#   WEBSITE_BUILDER_firebase_admin_private_key=...
#   WEBSITE_BUILDER_firebase_admin_client_email=...
#   <TENANT>_STRIPE_SECRET=...
#   <TENANT>_STRIPE_WEBHOOK_SECRET=...
#   <TENANT>_STRIPE_PUBLISHABLE=...

# Firebase web API key (server-side Identity Toolkit REST, Section 17/C9) — optional
FIREBASE_API_KEY=
